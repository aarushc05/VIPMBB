# Copy this file to .env and replace the placeholders.
# Never commit .env or share these values in screenshots or chat.
KINEXON_USER=your-username
KINEXON_PASSWORD=your-password
KINEXON_API_KEY=your-api-key

# Optional source configuration. A populated database is bound to its source
# and team; use a separate database to analyze a different team.
# KINEXON_BASE_URL=https://georgia-tech-mccamish.access.kinexon.com
# KINEXON_TEAM_ID=3
