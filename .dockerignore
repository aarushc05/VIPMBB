# An allowlist prevents credentials, athlete data, models, and Git history
# from ever entering the Docker build context.
**
!requirements.txt
!server/
!server/**
!client/
!client/package.json
!client/package-lock.json
!client/index.html
!client/vite.config.js
!client/src/
!client/src/**
!client/tests/
!client/tests/**
!infra/
!infra/Dockerfile
!tests/
!tests/*.py
**/__pycache__/
**/*.pyc
**/.env*
**/*.sqlite3*
**/node_modules/
**/dist/
